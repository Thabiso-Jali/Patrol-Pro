# Local development defaults. Never commit a populated .env file.
APP_ENV=development
APP_NAME=Patrol Pro API
DEBUG=false
DATABASE_URL=sqlite:///./patrol_pro.db

# Placeholder only: generate a unique secret for every deployed environment.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_IDLE_TIMEOUT_MINUTES=30
# Development-only escape hatch for manual invitation acceptance testing.
# Keep disabled. Demo and production configurations reject true.
EXPOSE_DEVELOPMENT_INVITATION_TOKENS=false

CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=INFO

HOST=127.0.0.1
PORT=8000
RELOAD=true
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
ENABLE_SECURITY_HEADERS=true
ENABLE_RATE_LIMITING=true
API_VERSION=1.0.0
API_DESCRIPTION=Professional security patrol management platform
